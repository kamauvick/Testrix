{
  "name": "testrix-cli",
  "version": "1.2.0",
  "description": "Parse JUnit, Playwright, HTML and Excel test reports and publish them to a Testrix dashboard API.",
  "main": "src/index.js",
  "bin": {
    "testrix": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 80 --functions 80 --branches 70 node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "cli",
    "test",
    "report",
    "junit",
    "playwright",
    "vitest",
    "pest",
    "automation",
    "ci"
  ],
  "author": "MyWorkPay QA",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cheerio": "^1.1.0",
    "saxes": "^6.0.0",
    "stream-json": "^1.9.1",
    "undici": "^7.0.0"
  },
  "optionalDependencies": {
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "c8": "^12.0.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "files": [
    "cli.js",
    "src/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kamauvick/Testrix.git"
  },
  "bugs": {
    "url": "https://github.com/kamauvick/Testrix/issues"
  },
  "homepage": "https://github.com/kamauvick/Testrix#readme"
}
