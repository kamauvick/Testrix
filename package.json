{
  "name": "testrix-cli",
  "version": "1.3.0",
  "description": "Parse test reports (JUnit, Playwright, TestNG, NUnit3, .trx, Mochawesome, CTRF, TAP, k6, JMeter, HTML, Excel) and publish the results to a Testrix dashboard API.",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "testrix": "./cli.js"
  },
  "scripts": {
    "start": "node cli.js",
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov --check-coverage --lines 80 --functions 80 --branches 70 node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types:check": "tsc --noEmit --strict --skipLibCheck src/index.d.ts",
    "prepublishOnly": "npm run lint && npm run format:check && npm run types:check && npm test"
  },
  "keywords": [
    "cli",
    "test",
    "report",
    "junit",
    "playwright",
    "vitest",
    "pest",
    "automation",
    "ci"
  ],
  "author": "MyWorkPay QA",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cheerio": "1.2.0",
    "saxes": "^6.0.0",
    "stream-json": "^1.9.1",
    "undici": "^6.28.1"
  },
  "overrides": {
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "c8": "^9.1.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "files": [
    "cli.js",
    "config.schema.json",
    "src/",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kamauvick/Testrix.git"
  },
  "bugs": {
    "url": "https://github.com/kamauvick/Testrix/issues"
  },
  "homepage": "https://github.com/kamauvick/Testrix#readme"
}
